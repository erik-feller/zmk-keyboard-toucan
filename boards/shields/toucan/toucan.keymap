#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYM  1
#define NUM  2
#define GAME 3

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB      &kp Q       &kp W  &kp E  &kp R  &kp T                         &kp Y  &kp U  &kp I     &kp O   &kp P          &kp BSPC
                &lt NUM ESC  &kp A       &kp S  &kp D  &kp F  &kp G                         &kp H  &kp J  &kp K     &kp L   &kp SEMI       &kp SQT
                &kp LSHFT    &mt LSHFT Z &kp X  &kp C  &kp V  &kp B                         &kp N  &kp M  &kp COMMA &kp DOT &mt RSHFT FSLH &kp RET
                                   &mt LCTRL DEL &mt SYM SPACE &lt LALT RET     &lt SYM RET &lt NUM BSPC  &kp TAB
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp GRAVE &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET    &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp BSPC
                &kp DEL   &kp F1   &kp F2 &kp F3   &kp F4   &kp F5      &kp SQT      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &kp BSLH
                &trans    &kp F7   &kp F8 &kp F9   &kp F10  &kp F11     &kp GRAVE    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp MINUS
                                                &trans &trans &trans    &trans &trans &trans
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
                &trans &kp N1 &kp N2 &kp N3 &kp N4  &kp N5    &kp N6         &kp N7         &kp N8       &kp N9     &kp N0    &kp C_VOL_DN
                &trans &kp F1 &kp F2 &kp F3 &kp F4  &kp F5    &bt BT_CLR     &kp MINUS      &kp EQUAL    &kp LBKT   &kp RBKT  &kp C_VOL_UP
                &trans &kp F7 &kp F8 &kp F9 &kp F10 &kp F11   &bt BT_PRV     &bt BT_NXT     &mkp LCLK    &mkp RCLK  &mkp MCLK &kp C_NEXT
                                          &trans &trans &trans    &trans &trans &trans
            >;
        };

        game {
            display-name = "GAME";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &tog GAME    &none        &none        &none        &out OUT_TOG &studio_unlock
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &none        &none        &none        &none        &none        &bootloader
                                   &kp N3 &kp N4 &kp SPACE    &none &none &none
            >;
        };

        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
